# Shared backend settings. Inject real values through the deployment platform.
VOC_RUNTIME_PROFILE=external_review
VOC_DATABASE_URL=
VOC_WRITER_PASSWORD_HASH=

# Legacy local training-database connection. VOC_DATABASE_URL takes precedence.
VOC_DB_HOST=localhost
VOC_DB_PORT=5432
VOC_DB_NAME=학습용 Data
VOC_DB_USER=postgres
VOC_DB_PASSWORD=

# Internal profile only. External review ignores these even if set.
VOC_SMTP_HOST=
VOC_SMTP_PORT=25
VOC_SMTP_USERNAME=
VOC_SMTP_PASSWORD=
VOC_SMTP_FROM=
VOC_TRANSLATION_COMMAND=
VOC_TRANSLATION_MODEL_PATH=

# Next.js server-side API proxy. Keep NEXT_PUBLIC_API_BASE_URL empty for same-origin /api calls.
VOC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
